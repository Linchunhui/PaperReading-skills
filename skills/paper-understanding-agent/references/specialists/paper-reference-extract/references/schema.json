{
  "type": "object",
  "properties": {
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_block_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^p[0-9]{4,}-b[0-9]{4,}$"
            }
          },
          "raw_text": {
            "type": "string",
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
            "minLength": 1,
            "maxLength": 30000
          },
          "label": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
                "minLength": 1,
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
                "minLength": 1,
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ]
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "authors_truncated": {
            "type": "boolean"
          },
          "source": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "conference",
                  "journal",
                  "preprint",
                  "book",
                  "thesis",
                  "report",
                  "web",
                  "other",
                  "unknown"
                ]
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "year": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "volume": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "issue": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pages": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "arxiv_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "doi": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "name",
              "year",
              "volume",
              "issue",
              "pages",
              "arxiv_id",
              "doi"
            ],
            "additionalProperties": false
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "incomplete_entry",
                "ambiguous_boundary",
                "ocr_corruption",
                "missing_title",
                "missing_authors",
                "unknown_source"
              ]
            }
          }
        },
        "required": [
          "source_block_ids",
          "raw_text",
          "label",
          "title",
          "authors",
          "authors_truncated",
          "source",
          "issues"
        ],
        "additionalProperties": false
      }
    },
    "unparsed_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_block_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^p[0-9]{4,}-b[0-9]{4,}$"
            }
          },
          "raw_text": {
            "type": "string",
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
            "minLength": 1,
            "maxLength": 30000
          },
          "reason": {
            "type": "string",
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]+$",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "source_block_ids",
          "raw_text",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "references",
    "unparsed_segments"
  ],
  "additionalProperties": false
}
